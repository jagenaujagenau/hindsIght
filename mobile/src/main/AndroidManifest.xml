<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hindsight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hindsight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Wakes on any Data Layer traffic from the watch. Google Play services
            binds this directly; it needs no exported activity of its own.
        -->
        <!--
            No android:permission here. That attribute constrains the *caller*, and
            Google Play services does not hold BIND_LISTENER_SERVICE, so declaring
            it makes GMS permanently unable to bind and every clip is dropped.
            Incoming paths are validated in code instead.
        -->
        <service
            android:name=".sync.ClipReceiverService"
            android:exported="true">
            <!--
                Scheme + host only, deliberately. A pathPrefix here silently stops
                Play services routing channel events at all; the service validates
                the path itself via WearProtocol.fileNameFromChannelPath.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

    </application>
</manifest>
