---
import Hero from '../sections/Hero.astro';
import Story from '../sections/Story.astro';
import Transfer from '../sections/Transfer.astro';
import Privacy from '../sections/Privacy.astro';
import Engineering from '../sections/Engineering.astro';
import Finale from '../sections/Finale.astro';
import { SOURCE } from '../lib/product';
import Icon from '../components/ui/Icon';
import '@fontsource-variable/manrope';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <meta name="description" content="Stay in the conversation. Hindsight gives you a few minutes to decide what’s worth remembering. Tap your Wear OS watch to save what you just heard." />
    <meta property="og:title" content="Hindsight — Remember what just happened." />
    <meta property="og:description" content="Be here. Keep what matters. Hindsight gives you a few minutes to decide what’s worth remembering on your Wear OS watch." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={Astro.site ? new URL('/social.png?v=wear-os', Astro.site).href : '/social.png?v=wear-os'} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hindsight — Remember what just happened. Your Wear OS watch. A few minutes to change your mind." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Hindsight — Remember what just happened.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="site-nav" aria-label="Main navigation"><a href="#top" class="wordmark">HINDSIGHT<span class="nav-dot"></span></a><div><a href="#how-it-works">How it works</a><a href="#privacy">Privacy</a><a href={SOURCE}>GitHub <Icon name="arrow-up-right" /></a></div></nav>
    <main id="main"><Hero /><Story /><Transfer /><Privacy /><Engineering /><Finale /></main>
    <button class="motion-control" id="motion-control" aria-pressed="false" aria-label="Turn off cinematic motion"><span data-motion-play hidden><Icon name="play" /></span><span data-motion-pause><Icon name="pause" /></span><span class="motion-label">Motion</span></button>
    <noscript><style>.motion-control{display:none}</style><p class="noscript-message">The story works without JavaScript. Interactive sample controls require JavaScript.</p></noscript>
    <script>import '../scripts/animation/story';</script>
  </body>
</html>
